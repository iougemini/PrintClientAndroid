<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">瑜华印务管理系统</string>
    <string name="setup_title">服务器设置</string>
    <string name="shortcut_settings_short">服务器设置</string>
    <string name="shortcut_settings_long">修改内网服务器地址</string>

    <string name="setup_head">连接内网服务器</string>
    <string name="setup_desc">填写运行「瑜华印务管理系统」那台电脑的局域网地址。地址形如 http://192.168.1.50:8090，只填 IP 也可以，会自动补端口 8090。</string>
    <string name="setup_label">服务器地址</string>
    <string name="setup_hint">192.168.1.50</string>
    <string name="setup_tip">在哪找地址：在那台电脑上双击「启动系统.bat」，黑色窗口里「局域网访问」后面那一行就是；或在该电脑命令行执行 ipconfig 看 IPv4 地址。手机和电脑要连同一个 WiFi / 同一交换机。</string>
    <string name="setup_test">测试并进入</string>
    <string name="setup_testing">正在连接…</string>
    <string name="setup_ok">连接成功</string>
    <string name="err_bad_url">地址格式不对，示例：192.168.1.50 或 http://192.168.1.50:8090</string>

    <string name="err_title">连不上服务器</string>
    <string name="err_hint">请确认：① 服务端电脑已开机并运行「启动系统.bat」；② 手机和电脑在同一局域网；③ 地址和端口填对了。</string>
    <string name="err_retry">重试</string>
    <string name="err_change">修改地址</string>
    <string name="exit_hint">再按一次返回键退出</string>
</resources>
